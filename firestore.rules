rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flashcard_sets/{id}              { allow read: if true; }
    match /flashcards/{id}                  { allow read: if true; }
    match /passages/{id}                    { allow read: if true; }
    match /comprehension_questions/{id}     { allow read: if true; }
    match /dialogues/{id}                   { allow read: if true; }
    match /changelog/{id}                   { allow read: if true; }
    match /grammar_lessons/{id}             { allow read: if true; }
    match /grammar_questions/{id}           { allow read: if true; }
    match /listening_exercises/{id}         { allow read: if true; }
    match /patterns/{id}                    { allow read: if true; }
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    match /user_card_progress/{docId} {
      allow read, write: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /user_passage_progress/{docId} {
      allow read, write: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /user_dialogue_progress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /user_grammar_progress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /milestone_results/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /user_listening_progress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /user_pattern_progress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /topik_tests/{id}                 { allow read: if true; }
    match /topik_attempts/{docId} {
      allow read, write: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
    match /topik_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /placement_attempts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Users can only file reports (write-once), not read/edit/delete anyone's —
    // reviewed manually via the Firebase console or an admin script.
    match /issue_reports/{docId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }
  }
}